# Copy this file to .env and fill in your real values.
# Find both in the Browserbase dashboard: https://www.browserbase.com/overview

BROWSERBASE_API_KEY=REPLACE_WITH_YOUR_API_KEY
BROWSERBASE_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_ID

# Optional — only used by src/stagehand_demo.py to pick a specific LLM for
# act/extract/observe. Leave unset and Browserbase will use a default model.
MODEL_API_KEY=